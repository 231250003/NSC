# 忽略所有 src 内容（含子目录），但后面有例外
compiler/src/**

# 取消忽略 .g4 文件（必须先 unignore 父路径）
!compiler/src/
!compiler/src/*.g4
!compiler/src/*.java
# 取消忽略你指定的 Java 文件（必须层层 unignore）


# 再次忽略 ANTLR 生成的文件（通常不在你指定的路径里）
# 例如如果 ANTLR 生成在 /src/main/java/com/example/
# 就需要单独再忽略一遍它们：
compiler/src/Lexer.java
compiler/src/Parser.java
compiler/src/ParserBaseListener.java
compiler/src/ParserBaseVisitor.java
compiler/src/ParserListener.java
compiler/src/ParserVisitor.java

# 忽略构建产物
/classes
/target
/out

# IDE/系统文件
.DS_Store
/.idea
/.vscode
/nsc.iml
