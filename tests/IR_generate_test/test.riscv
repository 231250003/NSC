main_while.stmt:
  la t0, a
  lw t0, 0(t0)
  mv x8, t0
  sw x8, 0(sp)
  sw x1, 4(sp)
  mv x10, x8
  addi sp, sp, 8
  jal x1, f
  addi sp, sp, -8
  lw x1, 4(sp)
  lw x8, 0(sp)
  mv x8, x10
  li t0, 10
  sgt t1, x8, t0
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 2
  sw t2, 1600(sp)
  bnez x8, main_if.then
  j main_while.cond
main_while.cond:
  la t0, a
  lw t0, 0(t0)
  mv x8, t0
  sw x8, 0(sp)
  sw x1, 4(sp)
  mv x10, x8
  addi sp, sp, 8
  jal x1, f
  addi sp, sp, -8
