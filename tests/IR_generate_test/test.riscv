.data
a:
  .word 10
.globl a


.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  la t0, a
  lw t0, 0(t0)
  mv x8, t0
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  la t2, a
  sw x8, 0(t2)
  la t0, a
  lw t0, 0(t0)
  mv x8, t0
  sw x1, 0(sp)
  mv x10, x8
  addi sp, sp, 4
  jal x1, f
  addi sp, sp, -4
  lw x1, 0(sp)
  li t0, 0
  sw t0, 1600(sp)
  j main_while.cond
main_cur:
  la t0, a
  lw t0, 0(t0)
  mv x8, t0
  li t1, 1
