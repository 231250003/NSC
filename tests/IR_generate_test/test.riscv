  lw x8, 0(sp)
  mv x8, x10
  li t0, 10
  slt t1, x8, t0
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 3
  sw t2, 1600(sp)
  bnez x8, main_while.stmt
  j main_cur
main_if.then:
  la t0, a
  lw t0, 0(t0)
  mv x8, t0
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
