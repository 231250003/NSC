.data

.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  sw x1, 0(sp)
  li x10, 1
  addi sp, sp, 4
  jal x1, f
  addi sp, sp, -4
  lw x1, 0(sp)
  li t0, 0
  mv x10, t0
  addi sp, sp, 2044
  li a7, 93
  ecall
f:
  mv x8, x10
  j f_fEntry
f_fEntry:
  mv x8, x8
  mv x8, x8
  li t1, 1
  add t2, x8, t1
  mv x8, t2
  mv x8, x8
  ret
