.data

.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  sw x8, 0(sp)
  sw x1, 4(sp)
  li x10, 10
  addi sp, sp, 8
  jal x1, f
  addi sp, sp, -8
  lw x1, 4(sp)
  lw x8, 0(sp)
  mv x8, x10
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
g:
  mv x8, x10
  j g_gEntry
g_gEntry:
  mv x8, x8
  mv x8, x8
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  mv x10, x8
  ret
f:
  j f_fEntry
f_fEntry:
  li t2, 10
  mv x10, t2
  ret
x:
  j x_xEntry
x_xEntry:
  ret
t:
  j t_tEntry
t_tEntry:
  ret
