int x=10;
int z;
int g(int t,int y){
    y=y+1;
    z=z+1;
    x=x+1;
    return y+1;
}
int main(){
    int y=10;
    z=y;
    if(x>5 || y/2==0){
        int p=5;
        while(1){
            while(z<102){
                g(10,20);
            }
            if(x<50&&p>4){
                x=x+3;
                g(10,2);
                continue;
            }
            if(x>10) break;
        }
    }
    return x+1;
}