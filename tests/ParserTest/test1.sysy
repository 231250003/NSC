int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

int fibonacci(int n) {
    if (n <= 1) return n;
    return fibonacci(n - 1) + fibonacci(n - 2);
}

void printArray(int arr[][3]) {
  while(1){
        while(j==2) {
            if (arr[i][j] % 2 == 0) {
                continue;
            }
            if (arr[i][j] > 20) {
                break;
            }
        }
    }
    return;
}

