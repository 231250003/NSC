  .data
z:
  .word 3

  .text
  .globl main
main:
  addi sp, sp, -2044
  j mainEntry
mainEntry:
  j for.cond
cur:
  mv x10, 
  addi sp, sp, 2044
  li a7, 93
  ecall
for.stmt:
  sw x1, 16(sp)
  addi sp, sp, 20
  jal x1, print
  addi sp, sp, -20
  lw x1, 16(sp)
  li t2, 0
  li t0, 1
  mul t0, , t0
  add t2, t2, t0
  slli t2, t2, 2
  li t1, 0
  add t2, t2, t1
  add t2, t2, sp
  sw t2, 16(sp)
  add t2, , 
  li t0, 1
  add t1, , t0
  j for.cond
for.cond:
  li t2, 3
  slt t0, , t2
  mv t1, 
  li t2, 0
  xor t0, , t2
  snez t0, t0
  bnez , for.stmt
  j cur
print:
  j printEntry
printEntry:
  li t1, 3
  add t2, , t1
  la t0, z
  sw , 0(t0)
  li t1, 3
  add t2, , t1
  mv x10, 
  ret
