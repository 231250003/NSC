.data
z:
  .word 3
.globl z


.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  li t0, 1
  sw t0, 0(sp)
  li t1, 2
  sw t1, 4(sp)
  li t2, 3
  sw t2, 8(sp)
  li t0, 0
  sw t0, 12(sp)
  li t1, 0
  mv x11, t1
  li t2, 0
  mv x9, t2
  li t0, 0
  sw t0, 1600(sp)
  j main_for.cond
main_cur:
  mv x8, x11
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
main_for.stmt:
  sw x14, 16(sp)
  sw x9, 20(sp)
  sw x11, 24(sp)
  sw x13, 28(sp)
  sw x1, 32(sp)
  addi sp, sp, 36
  jal x1, print
  addi sp, sp, -36
  lw x1, 32(sp)
  lw x14, 16(sp)
  lw x9, 20(sp)
  lw x11, 24(sp)
  lw x13, 28(sp)
  mv x8, x11
  mv x11, x9
  li t2, 0
  li t1, 1
  mul t1, x11, t1
  add t2, t2, t1
  slli t2, t2, 2
  li t0, 0
  add t2, t2, t0
  add t2, t2, sp
  sw t2, 16(sp)
  lw x12, 16(sp),
  lw x12, 0(x12)
  mv x11, x12
  add t0, x8, x11
  mv x11, t0
  la t0, z
  lw t0, 0(t0)
  mv x8, t0
  add t1, x11, x8
  mv x11, t1
  lw x13, 0(sp)
  mv x8, x13
  add t2, x11, x8
  mv x8, t2
  mv x11, x8
  mv x8, x9
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  mv x9, x8
  mv x8, x9
  li t2, 3
  xor t0, x8, t2
  seqz t0, t0
  mv x8, t0
  mv t1, x8
  mv x8, t1
  li t2, 0
  xor t0, x8, t2
  snez t0, t0
  mv x8, t0
  lw t1, 16(sp)
  sw x12, 0(t1)
  sw x13, 0(sp)
  li t2, 2
  sw t2, 1600(sp)
  bnez x8, main_cur
  j main_merge
main_for.cond:
  lw x14, 0(sp)
  mv x8, x14
  li t0, 3
  slt t1, x8, t0
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  sw x14, 0(sp)
  li t2, 3
  sw t2, 1600(sp)
  bnez x8, main_for.stmt
  j main_cur
main_merge:
  lw t0, 0(sp)
  mv x8, t0
  li t1, 1
  add t2, x8, t1
  mv x8, t2
  sw x8, 0(sp)
  li t0, 4
  sw t0, 1600(sp)
  j main_for.cond
print:
  j print_printEntry
print_printEntry:
  la t0, z
  lw t0, 0(t0)
  mv x8, t0
  li t1, 3
  add t2, x8, t1
  mv x8, t2
  la t0, z
  sw x8, 0(t0)
  la t0, z
  lw t0, 0(t0)
  mv x8, t0
  li t1, 3
  add t2, x8, t1
  mv x8, t2
  mv x10, x8
