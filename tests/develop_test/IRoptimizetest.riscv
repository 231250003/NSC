.data

.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  li t0, 0
  mv x9, t0
  li t1, 0
  sw t1, 1600(sp)
  j main_while.cond
main_cur:
  li t2, 2
  mv x10, t2
  addi sp, sp, 2044
  li a7, 93
  ecall
main_while.stmt:
  mv x8, x9
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  mv x9, x8
  li t2, 2
  sw t2, 1600(sp)
  j main_while.cond
main_while.cond:
  mv x8, x9
  li t0, 6
  slt t1, x8, t0
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 3
  sw t2, 1600(sp)
  bnez x8, main_while.stmt
  j main_cur
