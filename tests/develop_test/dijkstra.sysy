#include<iostream>
#include<cstring>
using namespace std;
int e[101][101],dis[1001],book[1001];
int main()
{
	int n,m,a,b,c;
    n=6;m=9;
    int
    {
    	for(int j=1;j<=n;j++)
    	{
    		if(i==j) e[i][j]=0;
    		else e[i][j]=9999;
		}
	}
    for(int i=1;i<=m;i++)
    {
    	cin>>a>>b>>c;
    	e[a][b]=c;
	}
	for(int i=1;i<=n;i++)
	{
		dis[i]=e[1][i];
	}
	int t,min=99999;
	for(int i=1;i<=n;i++)
	{
		min=99999;
	    for(int j=1;j<=n;j++)
		{
		    if(book[j]==0&&dis[j]<min)
			{
				min=dis[j];
				t=j;
			}
		}
		book[t]=1;
		for(int k=1;k<=n;k++)
		{
			if(book[k]==0&&dis[k]>dis[t]+e[t][k])
			{
				dis[k]=dis[t]+e[t][k];
			}
		}
	}
	for(int i=1;i<=n;i++)
	{
		cout<<dis[i]<<" ";
	}
}
