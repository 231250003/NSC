.data

.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  li t0, 0
  mv x9, t0
  li t1, 1
  mv x11, t1
  li t2, 0
  sw t2, 1600(sp)
  j main_for.cond
main_cur:
  mv x8, x9
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
main_for.stmt:
  mv x9, x9
  mv x8, x11
  add t0, x9, x8
  mv x8, t0
  mv x9, x8
  mv x8, x11
  li t1, 1
  add t2, x8, t1
  mv x8, t2
  mv x11, x8
  li t0, 2
  sw t0, 1600(sp)
  j main_for.cond
main_for.cond:
  mv x8, x11
  li t1, 10
  sgt t2, x8, t1
  seqz t2, t2
  mv x8, t2
  mv t0, x8
  mv x8, t0
  li t1, 0
  xor t2, x8, t1
  snez t2, t2
  mv x8, t2
  li t0, 3
  sw t0, 1600(sp)
  bnez x8, main_for.stmt
  j main_cur
