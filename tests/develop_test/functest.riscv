
  .text
  .globl main
main:
  addi sp, sp, -2044
  j mainEntry
mainEntry:
  li t0, 30
  mv x8, t0
  sw x8, 0(sp)
  sw x1, 4(sp)
  li x10, 10
  li x11, 20
  li x12, 30
  addi sp, sp, 8
  jal x1, f
  addi sp, sp, -8
  lw x1, 4(sp)
  lw x8, 0(sp)
  mv x8, x10
  mv x8, x8
  mv x8, x8
  li t1, 5
  add t2, x8, t1
  mv x8, t2
  mv x8, x8
  mv x8, x8
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
f:
  mv x9, x11
  mv x8, x12
  mv t0, x0
  mv x11, t0
  j fEntry
fEntry:
  mv x11, x11
  mv x9, x9
  mv x12, x8
  mv x11, x11
  mv x8, x9
  add t1, x11, x8
  mv x9, t1
  mv x8, x12
  add t2, x9, x8
  mv x8, t2
  mv x10, x8
  ret
