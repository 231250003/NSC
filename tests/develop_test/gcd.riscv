
  .text
  .globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  li t0, 25
  mv x9, t0
  li t1, 40
  mv x8, t1
  mv x9, x9
  mv x8, x8
  sw x8, 0(sp)
  sw x1, 4(sp)
  mv x11, x8
  mv x10, x9
  addi sp, sp, 8
  jal x1, gcd
  addi sp, sp, -8
  lw x1, 4(sp)
  lw x8, 0(sp)
  mv x8, x10
  mv x8, x8
  mv x8, x8
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
gcd:
  mv x9, x10
  mv x8, x11
  j gcd_gcdEntry
gcd_gcdEntry:
  mv x12, x9
  mv x8, x8
  mv x9, x8
  li t2, 0
  xor t0, x9, t2
  seqz t0, t0
  mv x9, t0
  mv t1, x9
  mv x9, t1
  li t2, 0
  xor t0, x9, t2
  snez t0, t0
  mv x9, t0
  li t1, 0
  sw t1, 1600(sp)
  bnez x9, gcd_if.then
  j gcd_merge
gcd_merge:
  mv x11, x8
  mv x9, x12
  mv x8, x8
  rem t2, x9, x8
  mv x8, t2
  sw x8, 0(sp)
  sw x1, 4(sp)
  mv x10, x11
  mv x11, x8
  addi sp, sp, 8
  jal x1, gcd
  addi sp, sp, -8
  lw x1, 4(sp)
  lw x8, 0(sp)
  mv x8, x10
  mv x10, x8
  ret
gcd_if.then:
  mv x8, x12
  mv x10, x8
  ret
