
  .text
  .globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  lw x8, 0(sp)
  li t0, 10
  mv x8, t0
  lw x9, 4(sp)
  li t1, 1
  mv x9, t1
  sw x1, 8(sp)
  sw x8, 0(sp)
  sw x9, 4(sp)
  addi x10, sp, 0
  li x11, 0
  li x12, 1
  addi sp, sp, 12
  jal x1, swap
  addi sp, sp, -12
  lw x1, 8(sp)
  lw x11, 0(sp)
  mv x8, x11
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
swap:
  sw x10, 0(sp)
  mv x9, x11
  mv t2, x12
  mv x11, t2
  j swap_swapEntry
swap_swapEntry:
  mv x9, x9
  mv x11, x11
  mv x8, x9
  li t2, 0
  li t1, 1
  mul t1, x8, t1
  add t2, t2, t1
  slli t2, t2, 2
  lw t0, 0(sp)
  add t2, t2, t0
  sw t2, 4(sp)
  lw x8, 4(sp),
  lw x8, 0(x8)
  mv x8, x8
  mv x8, x9
  li t2, 0
  li t1, 1
  mul t1, x8, t1
  add t2, t2, t1
  slli t2, t2, 2
  lw t0, 0(sp)
  add t2, t2, t0
  sw t2, 8(sp)
  lw x12, 8(sp),
  lw x12, 0(x12)
  mv x8, x11
  li t2, 0
  li t1, 1
  mul t1, x8, t1
  add t2, t2, t1
  slli t2, t2, 2
  lw t0, 0(sp)
  add t2, t2, t0
  sw t2, 12(sp)
  lw x13, 12(sp),
  lw x13, 0(x13)
  mv x8, x13
  mv x12, x8
  ret
