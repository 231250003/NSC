.data

.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  sw x8, 0(sp)
  sw x1, 4(sp)
  li x10, 5
  addi sp, sp, 8
  jal x1, f
  addi sp, sp, -8
  lw x1, 4(sp)
  lw x8, 0(sp)
  mv x8, x10
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
f:
  mv x8, x10
  j f_fEntry
f_fEntry:
  mv x9, x8
  mv x8, x9
  li t0, 0
  xor t1, x8, t0
  seqz t1, t1
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 0
  sw t2, 1600(sp)
  bnez x8, f_if.then
  j f_merge
f_merge:
  mv x8, x9
  li t0, 1
  xor t1, x8, t0
  seqz t1, t1
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 1
  sw t2, 1600(sp)
  bnez x8, f_if.then5
  j f_if.else
f_if.then:
  li t0, 0
  mv x10, t0
  ret
f_if.then5:
  li t1, 1
  mv x10, t1
  ret
f_if.else:
  mv x8, x9
  li t2, 1
  sub t0, x8, t2
  mv x8, t0
  sw x11, 0(sp)
  sw x9, 4(sp)
  sw x1, 8(sp)
  mv x10, x8
  addi sp, sp, 12
  jal x1, f
  addi sp, sp, -12
  lw x1, 8(sp)
  lw x11, 0(sp)
  lw x9, 4(sp)
  mv x11, x10
  mv x8, x9
  li t1, 2
  sub t2, x8, t1
  mv x8, t2
  sw x8, 0(sp)
  sw x11, 4(sp)
  sw x1, 8(sp)
  mv x10, x8
  addi sp, sp, 12
  jal x1, f
  addi sp, sp, -12
  lw x1, 8(sp)
  lw x8, 0(sp)
  lw x11, 4(sp)
  mv x8, x10
  add t0, x11, x8
  mv x8, t0
  mv x10, x8
  ret
