
  .text
  .globl main
main:
  addi sp, sp, -2044
  j mainEntry
mainEntry:
  li t0, 1
  mv x8, t0
  li t1, 2
  mv x9, t1
  mv x8, x8
  li t2, 2
  mul t0, x8, t2
  mv x8, t0
  mv x8, x8
  mv x9, x9
  li t1, 2
  mul t2, x9, t1
  mv x9, t2
  mv x9, x9
  mv x11, x8
  mv x8, x9
  add t0, x11, x8
  mv x8, t0
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
