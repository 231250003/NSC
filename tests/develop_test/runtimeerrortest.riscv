.data
x:
  .word 5
.globl x


.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  la t0, x
  lw t0, 0(t0)
  mv x8, t0
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  la t2, x
  sw x8, 0(t2)
  la t0, x
  lw t0, 0(t0)
  mv x8, t0
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
