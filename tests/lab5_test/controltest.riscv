
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 0
  mv x1, t0
  li t1, 0
  mv x3, t1
  j while.cond
cur:
  mv x8, x1
  mv x9, x3
  add t2, x8, x9
  mv x10, t2
  mv a0, x10
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  li t0, 0
  mv x3, t0
  j while.cond3
while.cond:
  mv x12, x1
  li t1, 3
  slt t2, x12, t1
  mv x13, t2
  mv t0, x13
  mv x14, t0
  li t1, 0
  xor t2, x14, t1
  snez t2, t2
  mv x15, t2
  bnez x15, while.stmt
  j cur
cur1:
  mv x18, x1
  li t0, 1
  add t1, x18, t0
  mv x19, t1
  mv x1, x19
  j while.cond
while.stmt2:
  mv x20, x3
  li t2, 2
  xor t0, x20, t2
  seqz t0, t0
  mv x21, t0
  mv t1, x21
  mv x22, t1
  li t2, 0
  xor t0, x22, t2
  snez t0, t0
  mv x23, t0
  bnez x23, if.then
  j merge
while.cond3:
  mv x26, x3
  li t1, 5
  slt t2, x26, t1
  mv x27, t2
  mv t0, x27
  mv x28, t0
  li t1, 0
  xor t2, x28, t1
  snez t2, t2
