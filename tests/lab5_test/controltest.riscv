
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 0
  mv x1, t0
  li t1, 0
  mv x3, t1
  j while.cond
cur:
  mv x8, x3
  mv a0, x8
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x9, x3
  mv x10, x1
  add t2, x9, x10
  mv x11, t2
  mv x3, x11
  mv x12, x3
  li t0, 10
  sgt t1, x12, t0
  mv x13, t1
  mv t2, x13
  mv x14, t2
  li t0, 0
  xor t1, x14, t0
  snez t1, t1
  mv x15, t1
  bnez x15, if.then
  j merge
while.cond:
  mv x18, x1
  li t2, 6
  slt t0, x18, t2
  mv x19, t0
  mv t1, x19
  mv x20, t1
  li t2, 0
  xor t0, x20, t2
  snez t0, t0
  mv x21, t0
  bnez x21, while.stmt
  j cur
merge:
  mv x24, x1
  li t1, 1
  add t2, x24, t1
  mv x25, t2
  mv x1, x25
  j while.cond
if.then:
  j cur
