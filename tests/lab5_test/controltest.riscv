  .data
x:
  .word 56
  .data
y:
  .word 98

  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  la t0, x
  lw t0, 0(t0)
  mv x3, t0
  mv x1, x3
  la t1, y
  lw t1, 0(t1)
  mv x8, t1
  mv x4, x8
  j while.cond
cur:
  mv x10, x1
  mv x9, x10
  mv x11, x9
  mv a0, x11
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x12, x1
  mv x13, x4
  sgt t2, x12, x13
  mv x14, t2
  mv t0, x14
  mv x15, t0
  li t1, 0
  xor t2, x15, t1
  snez t2, t2
  mv x16, t2
  bnez x16, if.then
  j if.else
while.cond:
  mv x17, x4
  li t0, 0
  xor t1, x17, t0
  snez t1, t1
  mv x18, t1
  mv t2, x18
  mv x20, t2
  li t0, 0
  xor t1, x20, t0
  snez t1, t1
  mv x23, t1
  bnez x23, while.stmt
  j cur
merge:
  j while.cond
if.then:
  mv x25, x1
  mv x27, x4
  sub t2, x25, x27
  mv x28, t2
  mv x1, x28
  j merge
if.else:
  mv x11, x4
  mv x17, x1
  sub t0, x11, x17
  mv x21, t0
  mv x4, x21
  j merge
