
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 0
  mv x1, t0
  li t1, 0
  mv x3, t1
  j while.cond
cur:
  mv x9, x3
  mv a0, x9
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x10, x1
  li t2, 2
  xor t0, x10, t2
  seqz t0, t0
  mv x11, t0
  mv t1, x11
  mv x12, t1
  li t2, 0
  xor t0, x12, t2
  snez t0, t0
  mv x13, t0
  bnez x13, if.then
  j if.else
while.cond:
  mv x16, x1
  li t1, 8
  slt t2, x16, t1
  mv x17, t2
  mv t0, x17
  mv x18, t0
  li t1, 0
  xor t2, x18, t1
  snez t2, t2
  mv x19, t2
  bnez x19, while.stmt
  j cur
merge:
  mv x22, x1
  li t0, 1
  add t1, x22, t0
  mv x23, t1
  mv x1, x23
  j while.cond
if.then:
  mv x24, x3
  li t2, 3
  add t0, x24, t2
  mv x25, t0
  mv x3, x25
  j merge
if.else:
  mv x27, x1
  li t1, 4
  xor t2, x27, t1
  seqz t2, t2
  mv x28, t2
  mv t0, x28
  mv x29, t0
  li t1, 0
  xor t2, x29, t1
  snez t2, t2
  mv x30, t2
  bnez x30, if.then10
  j if.else11
merge6:
  j merge
if.then10:
  mv x10, x3
  li t0, 1
  sub t1, x10, t0
  mv x11, t1
  mv x3, x11
  j merge6
if.else11:
  mv x13, x3
  li t2, 1
  add t0, x13, t2
  mv x15, t0
