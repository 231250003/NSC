
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 0
  mv x1, t0
  li t1, 0
  mv x3, t1
  j while.cond
cur:
  mv x8, x3
  mv a0, x8
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x9, x1
  li t2, 2
  rem t0, x9, t2
  mv x10, t0
  li t1, 0
  xor t2, x10, t1
  seqz t2, t2
  mv x11, t2
  mv t0, x11
  mv x12, t0
  li t1, 0
  xor t2, x12, t1
  snez t2, t2
  mv x13, t2
  bnez x13, if.then
  j merge
while.cond:
  mv x16, x1
  li t0, 10
  slt t1, x16, t0
  mv x17, t1
  mv t2, x17
  mv x18, t2
  li t0, 0
  xor t1, x18, t0
  snez t1, t1
  mv x19, t1
  bnez x19, while.stmt
  j cur
merge:
  mv x22, x1
  li t2, 7
  xor t0, x22, t2
  seqz t0, t0
  mv x23, t0
  mv t1, x23
  mv x24, t1
  li t2, 0
  xor t0, x24, t2
  snez t0, t0
  mv x25, t0
  bnez x25, if.then10
  j merge6
if.then:
  mv x28, x1
  li t1, 1
  add t2, x28, t1
  mv x29, t2
  mv x1, x29
  j while.cond
merge6:
  mv x30, x3
  mv x31, x1
  add t0, x30, x31
  mv x8, t0
  mv x3, x8
  mv x9, x1
  li t1, 1
  add t2, x9, t1
  mv x10, t2
  mv x1, x10
