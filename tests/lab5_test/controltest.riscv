
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 0
  mv x1, t0
  li t1, 0
  mv x3, t1
  j while.cond
cur:
  mv x4, x3
  mv a0, x4
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x8, x1
  li t2, 2
  xor t0, x8, t2
  seqz t0, t0
  mv x9, t0
  mv t1, x9
  mv x10, t1
  li t2, 0
  xor t0, x10, t2
  snez t0, t0
  mv x11, t0
  bnez x11, if.then
  j if.else
while.cond:
  mv x12, x1
  li t1, 8
  slt t2, x12, t1
  mv x13, t2
  mv t0, x13
  mv x14, t0
  li t1, 0
  xor t2, x14, t1
  snez t2, t2
  mv x15, t2
  bnez x15, while.stmt
  j cur
merge:
  mv x16, x1
  li t0, 1
  add t1, x16, t0
  mv x17, t1
  mv x1, x17
  j while.cond
if.then:
  mv x18, x3
  li t2, 3
  add t0, x18, t2
  mv x19, t0
  mv x3, x19
  j merge
if.else:
  mv x20, x1
  li t1, 4
  xor t2, x20, t1
  seqz t2, t2
  mv x21, t2
  mv t0, x21
  mv x22, t0
  li t1, 0
  xor t2, x22, t1
  snez t2, t2
  mv x23, t2
  bnez x23, if.then10
  j if.else11
merge6:
  j merge
if.then10:
  mv x24, x3
  li t0, 1
  sub t1, x24, t0
  mv x25, t1
  mv x3, x25
  j merge6
if.else11:
  mv x26, x3
  li t2, 1
  add t0, x26, t2
  mv x27, t0
  mv x3, x27
