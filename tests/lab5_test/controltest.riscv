
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 0
  mv x1, t0
  li t1, 0
  mv x3, t1
  mv x4, x1
  li t2, 0
  xor t0, x4, t2
  seqz t0, t0
  mv x8, t0
  mv t1, x8
  mv x9, t1
  li t2, 0
  xor t0, x9, t2
  snez t0, t0
  mv x10, t0
  bnez x10, if.then
  j merge
merge:
  mv x13, x3
  mv a0, x13
  addi sp, sp, 512
  li a7, 93
  ecall
if.then:
  j while.cond
cur:
  j merge
while.stmt:
  mv x15, x3
  li t1, 1
  add t2, x15, t1
  mv x16, t2
  mv x3, x16
  j while.cond
while.cond:
  mv x17, x3
  li t0, 5
  slt t1, x17, t0
  mv x18, t1
  mv t2, x18
  mv x19, t2
  li t0, 0
  xor t1, x19, t0
  snez t1, t1
  mv x20, t1
  bnez x20, while.stmt
  j cur
