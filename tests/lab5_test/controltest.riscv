  .data
x:
  .word 56
  .data
y:
  .word 98

.macro LOAD_WORD(%rd, %rs, %imm)
    lw %rd, %imm(%rs) 
.end_macro
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  la t0, x
  LOAD_WORD( t0, t0, 0)
  sw t0, 8(sp)
  LOAD_WORD( t1, sp, 8)
  sw t1, 4(sp)
  la t2, y
  LOAD_WORD( t2, t2, 0)
  sw t2, 16(sp)
  LOAD_WORD( t0, sp, 16)
  sw t0, 12(sp)
  j while.cond
cur:
  LOAD_WORD( t1, sp, 4)
  sw t1, 24(sp)
  LOAD_WORD( t2, sp, 24)
  sw t2, 20(sp)
  LOAD_WORD( t0, sp, 20)
  sw t0, 28(sp)
  LOAD_WORD( t1, sp, 28)
  mv a0, t1
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  LOAD_WORD( t2, sp, 4)
  sw t2, 32(sp)
  LOAD_WORD( t0, sp, 12)
  sw t0, 36(sp)
  LOAD_WORD( t1, sp, 32)
  LOAD_WORD( t2, sp, 36)
  sgt t0, t1, t2
  sw t0, 40(sp)
  LOAD_WORD( t1, sp, 40)
  mv t2, t1
  sw t2, 44(sp)
  LOAD_WORD( t0, sp, 44)
  li t1, 0
  xor t2, t0, t1
  snez t2, t2
  sw t2, 48(sp)
  LOAD_WORD( t0, sp, 48)
  bnez t0, if.then
  j if.else
while.cond:
  LOAD_WORD( t1, sp, 12)
  sw t1, 52(sp)
  LOAD_WORD( t2, sp, 52)
  li t0, 0
  xor t1, t2, t0
  snez t1, t1
  sw t1, 56(sp)
  LOAD_WORD( t2, sp, 56)
  mv t0, t2
  sw t0, 60(sp)
  LOAD_WORD( t1, sp, 60)
  li t2, 0
  xor t0, t1, t2
  snez t0, t0
  sw t0, 64(sp)
  LOAD_WORD( t1, sp, 64)
  bnez t1, while.stmt
  j cur
merge:
  j while.cond
if.then:
  LOAD_WORD( t2, sp, 4)
  sw t2, 68(sp)
  LOAD_WORD( t0, sp, 12)
  sw t0, 72(sp)
  LOAD_WORD( t1, sp, 68)
  LOAD_WORD( t2, sp, 72)
  sub t0, t1, t2
  sw t0, 76(sp)
  LOAD_WORD( t1, sp, 76)
  sw t1, 4(sp)
  j merge
if.else:
  LOAD_WORD( t2, sp, 12)
  sw t2, 80(sp)
  LOAD_WORD( t0, sp, 4)
  sw t0, 84(sp)
  LOAD_WORD( t1, sp, 80)
  LOAD_WORD( t2, sp, 84)
  sub t0, t1, t2
  sw t0, 88(sp)
  LOAD_WORD( t1, sp, 88)
  sw t1, 12(sp)
  j merge
