  .data
x:
  .word 56
  .data
y:
  .word 98

  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  la t0, x
  lw t0, 0(t0)
  mv x3, t0
  mv x1, x3
  la t1, y
  lw t1, 0(t1)
  mv x8, t1
  mv x4, x8
  j while.cond
cur:
  mv x11, x1
  mv x10, x11
  mv x12, x10
  mv a0, x12
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x13, x1
  mv x14, x4
  li t2, 10
  add t0, x14, t2
  mv x15, t0
  sgt t1, x13, x15
  mv x16, t1
  mv t2, x16
  mv x17, t2
  li t0, 0
  xor t1, x17, t0
  snez t1, t1
  mv x18, t1
  bnez x18, if.then
  j if.else
while.cond:
  mv x21, x4
  mv x22, x1
  add t2, x21, x22
  mv x23, t2
  li t0, 20
  sgt t1, x23, t0
  mv x24, t1
  mv t2, x24
  mv x25, t2
  li t0, 0
  xor t1, x25, t0
  snez t1, t1
  mv x26, t1
  bnez x26, while.stmt
