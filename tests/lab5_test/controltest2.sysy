int x = 56;
int y = 98;

int main() {
    int a = x;
    int b = y;
    while (b+a>20) {
        if(a!=56) return 1;
        else return !a+b;
        while(a>10){
            if(a>40){
             a=a-5;
                        break;
              }
             else break;
        }
        while(b>35){
            if(b>70){
                b=b-5;
                continue;
            }
            else if(b>50) b=b-7;
            else if(b>30) b=b-1;
            else return 10;
            }
        b=b-3;
        a=a+1;
        if(a+b>50) a=a-10;
    }
    int result = a;
	return result;
}