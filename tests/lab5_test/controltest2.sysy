int x = 56;
int y = 98;

int main() {
    int a = x;
    int b = y;
    while(1){
        a=a-2;
        if(a==45) break;
        else if(a==48){
            b=b-3;
            a=a+1;
         }
    }
    while (b+a>20) {

        while(a>10){
            if(a>40){
             a=a-5;
                        break;
              }
             else break;
        }
        while(b>35){
            {
                int b=30;
                {
                    while(1){
                    return b;
                    }
                }
            }
            return b-10;
            if(b>70){
                b=b-5;
                continue;
            }
            else if(b>50) b=b-7;
            else if(b>30) b=b-1;
            else return 10;
            }
        b=b-3;
        a=a+1;
        if(a+b>50) a=a-10;
    }
    int result = a;
	return result;
}