
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  li t0, 1
  sw t0, 4(sp)
  lw t1, 4(sp)
  sw t1, 8(sp)
  lw t2, 8(sp)
  li t0, 1
  add t1, t2, t0
  sw t1, 12(sp)
  lw t2, 12(sp)
  sw t2, 4(sp)
  lw t0, 4(sp)
  sw t0, 16(sp)
  lw t1, 16(sp)
  mv a0, t1
  addi sp, sp, 512
  li a7, 93
  ecall
