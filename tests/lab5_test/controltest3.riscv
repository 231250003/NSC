  .data
x:
  .word 56
  .data
y:
  .word 98

  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  la t0, x
  lw t0, 0(t0)
  mv x3, t0
  mv x1, x3
  la t1, y
  lw t1, 0(t1)
  mv x8, t1
  mv x4, x8
  j while.cond
cur:
  mv x9, x1
  mv a0, x9
  addi sp, sp, 512
  li a7, 93
  ecall
while.stmt:
  mv x10, x1
  mv x11, x4
  sgt t2, x10, x11
  mv x12, t2
  mv t0, x12
  mv x13, t0
  li t1, 0
  xor t2, x13, t1
  snez t2, t2
  mv x14, t2
  bnez x14, if.then
  j if.else
while.cond:
  mv x15, x4
  li t0, 0
  xor t1, x15, t0
  snez t1, t1
  mv x16, t1
  mv t2, x16
  mv x17, t2
  li t0, 0
  xor t1, x17, t0
  snez t1, t1
  mv x18, t1
  bnez x18, while.stmt
  j cur
merge:
  j while.cond
if.then:
  mv x19, x1
  mv x20, x4
  sub t2, x19, x20
  mv x21, t2
  mv x1, x21
  j merge
if.else:
  mv x22, x4
  mv x23, x1
  sub t0, x22, x23
  mv x24, t0
  mv x4, x24
  j merge
