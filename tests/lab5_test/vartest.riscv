  .data
a:
  .word 1
  .data
dddd:
  .word 111
  .data
b:
  .word 0
  .data
cccc:
  .word 0

.macro LOAD_WORD(%rd, %rs, %imm)
    lw %rd, %imm(%rs) 
.end_macro
  .text
  .globl main
main:
  addi sp, sp, -512
mainEntry:
  la t0, a
  LOAD_WORD t0, 0(t0)
  sw t0, 4(sp)
  LOAD_WORD t1, 4(sp)
  li t2, 1
  add t0, t1, t2
  sw t0, 8(sp)
  la t1, cccc
  LOAD_WORD t1, 0(t1)
  sw t1, 12(sp)
  LOAD_WORD t2, 12(sp)
  li t0, 0
  xor t1, t2, t0
  seqz t1, t1
  sw t1, 16(sp)
  LOAD_WORD t2, 16(sp)
  mv t0, t2
  sw t0, 20(sp)
  LOAD_WORD t1, 20(sp)
  li t2, 0
  xor t0, t1, t2
  seqz t0, t0
  sw t0, 24(sp)
  LOAD_WORD t1, 24(sp)
  mv t2, t1
  sw t2, 28(sp)
  LOAD_WORD t0, 8(sp)
  LOAD_WORD t1, 28(sp)
  add t2, t0, t1
  sw t2, 32(sp)
  LOAD_WORD t0, 32(sp)
  la t1, b
  sw t0, 0(t1)
  la t2, b
  LOAD_WORD t2, 0(t2)
  sw t2, 36(sp)
  LOAD_WORD t0, 36(sp)
  mv a0, t0
  addi sp, sp, 512
  li a7, 93
  ecall
