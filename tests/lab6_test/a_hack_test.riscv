.data
.globl g1
g1:
  .word 1

.globl g2
g2:
  .word 2


.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  li t0, 0
  sw t0, 1600(sp)
  j main_while.cond
main_cur:
  li t1, -1
  mv x10, t1
  addi sp, sp, 2044
  li a7, 93
  ecall
main_while.stmt:
  la t0, g2
  lw t0, 0(t0)
  mv x8, t0
  li t2, 1
  slt t0, x8, t2
  mv x8, t0
  mv t1, x8
  mv x8, t1
  li t2, 0
  xor t0, x8, t2
  snez t0, t0
  mv x8, t0
  li t1, 2
  sw t1, 1600(sp)
  bnez x8, main_if.then
  j main_merge
main_while.cond:
  la t0, g1
  lw t0, 0(t0)
  mv x8, t0
  li t2, 0
  sgt t0, x8, t2
  mv x8, t0
  mv t1, x8
  mv x8, t1
  li t2, 0
  xor t0, x8, t2
  snez t0, t0
  mv x8, t0
  li t1, 3
  sw t1, 1600(sp)
  bnez x8, main_while.stmt
  j main_cur
main_merge:
  la t0, g2
  lw t0, 0(t0)
  mv x8, t0
  li t2, 1
  sub t0, x8, t2
  mv x8, t0
  la t1, g2
  sw x8, 0(t1)
  li t2, 4
  sw t2, 1600(sp)
  j main_while.cond
main_if.then:
  la t0, g1
  lw t0, 0(t0)
  mv x8, t0
  li t0, 1
  sgt t1, x8, t0
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 5
  sw t2, 1600(sp)
  bnez x8, main_if.then9
  j main_merge5
main_merge5:
  la t0, g1
  lw t0, 0(t0)
  mv x8, t0
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  la t2, g1
  sw x8, 0(t2)
  la t0, g2
  lw t0, 0(t0)
  mv x8, t0
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
main_if.then9:
  la t0, g2
  lw t0, 0(t0)
  mv x8, t0
  li t0, 1
  add t1, x8, t0
  mv x8, t1
  la t2, g2
  sw x8, 0(t2)
  la t0, g1
  lw t0, 0(t0)
  mv x8, t0
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
