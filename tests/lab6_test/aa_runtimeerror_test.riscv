.data
.globl x
x:
  .word 56

.globl y
y:
  .word 98


.text
.globl main
main:
  addi sp, sp, -2044
  j main_mainEntry
main_mainEntry:
  la t0, x
  lw t0, 0(t0)
  mv x8, t0
  mv x12, x8
  la t0, y
  lw t0, 0(t0)
  mv x8, t0
  mv x11, x8
  li t0, 0
  sw t0, 1600(sp)
  j main_while.cond
main_cur:
  mv x8, x12
  mv x8, x8
  mv x8, x8
  mv x10, x8
  addi sp, sp, 2044
  li a7, 93
  ecall
main_while.stmt:
  mv x8, x12
  mv x9, x11
  sgt t1, x8, x9
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 2
  sw t2, 1600(sp)
  bnez x8, main_if.then
  j main_if.else
main_while.cond:
  mv x8, x11
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  mv t2, x8
  mv x8, t2
  li t0, 0
  xor t1, x8, t0
  snez t1, t1
  mv x8, t1
  li t2, 3
  sw t2, 1600(sp)
  bnez x8, main_while.stmt
  j main_cur
main_if.then:
  mv x9, x12
  mv x8, x11
  sub t0, x9, x8
  mv x8, t0
  mv x12, x8
  li t1, 4
  sw t1, 1600(sp)
  j main_while.cond
main_if.else:
  mv x8, x11
  mv x9, x12
  sub t2, x8, x9
  mv x8, t2
  mv x11, x8
  li t0, 5
  sw t0, 1600(sp)
  j main_while.cond
