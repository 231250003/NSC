int x = 56;
int y = 98;

int main() {
  int a = x;
    int b = y;
  if(!a+b>=10) {
        if(a<=10) return 2;
     }
    while(1){
        a=a-2;
        if(a==45) break;
        else if(a==48){
            b=b-3;
            a=a+1;
         }
    }
      
        b=b-3;
        a=a+1;
        if(a+b>50) a=a-10;
    int result = a;
	return result;
}